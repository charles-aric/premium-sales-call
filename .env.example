# Copy these names into Vercel, Settings, Environment Variables.

# Any long random string. Signs the login cookie.
SESSION_SECRET=

# Stripe secret key, from Developers, API keys. sk_test_... while testing, sk_live_... at launch.
STRIPE_SECRET_KEY=

# Signing secret (whsec_...) shown on the Stripe webhook endpoint for /api/webhook.
STRIPE_WEBHOOK_SECRET=

# Set to true while testing with Stripe test cards. Remove before launch.
ALLOW_TEST_ORDERS=true

# Only if your video file in the Blob store is not named video.mp4.
# VIDEO_PATHNAME=video.mp4

# GA4 measurement id (G-XXXXXXXXXX). Leave empty to turn Google Analytics off.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project id. Leave empty to turn Clarity off.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel id from Events Manager (this site's is 1120822287178405). Leave empty to turn the pixel off.
NEXT_PUBLIC_META_PIXEL_ID=

# Added automatically when you connect Upstash Redis from the Vercel Storage tab.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Added automatically when you connect the private Blob store to the project.
# BLOB_STORE_ID=
